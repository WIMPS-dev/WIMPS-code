.data
int_prompt: .string "Enter an integer: "
string_prompt: .string "Enter a word: "
char_prompt: .string "Enter a character: "
int_label: .string "Integer: "
string_label: .string "Word: "
char_label: .string "Character: "
newline: .string "\n"
buffer: .space 32

.text
main:
  li a7, 4
  la a0, int_prompt
  ecall

  li a7, 5
  ecall
  mv s0, a0

  li a7, 4
  la a0, string_prompt
  ecall

  li a7, 8
  la a0, buffer
  li a1, 32
  ecall

  li a7, 4
  la a0, char_prompt
  ecall

  li a7, 12
  ecall
  mv s1, a0

  li a7, 4
  la a0, newline
  ecall

  li a7, 4
  la a0, int_label
  ecall

  li a7, 1
  mv a0, s0
  ecall

  li a7, 4
  la a0, newline
  ecall

  li a7, 4
  la a0, string_label
  ecall

  li a7, 4
  la a0, buffer
  ecall

  li a7, 4
  la a0, newline
  ecall

  li a7, 4
  la a0, char_label
  ecall

  li a7, 11
  mv a0, s1
  ecall

  li a7, 4
  la a0, newline
  ecall

  li a7, 10
  ecall
